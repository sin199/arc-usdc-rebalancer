ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
TREASURY_POLICY_ADDRESS=0x0000000000000000000000000000000000000000
TREASURY_EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000
# Legacy robot API surface used by the job center / demo worker flow.
NEXT_PUBLIC_EXECUTION_API_URL=http://127.0.0.1:8787
CIRCLE_API_BASE=https://api-sandbox.circle.com
NEXT_PUBLIC_CIRCLE_WALLET_MODE=developer-controlled
NEXT_PUBLIC_CIRCLE_TRANSFER_MODE=gateway
NEXT_PUBLIC_CIRCLE_SOURCE_CHAIN=Arc Testnet
NEXT_PUBLIC_CIRCLE_DESTINATION_CHAIN=Base
NEXT_PUBLIC_CIRCLE_WALLET_SET_ID=
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_WALLET_SET_NAME=Arc Treasury Control Plane
CIRCLE_WALLET_NAME=Arc Treasury Operator
CIRCLE_WALLET_BLOCKCHAIN=ARC-TESTNET
CIRCLE_WALLET_ACCOUNT_TYPE=EOA
CIRCLE_GATEWAY_API_BASE=https://gateway-api-testnet.circle.com
CIRCLE_GATEWAY_SOURCE_DOMAIN=26
CIRCLE_GATEWAY_DESTINATION_DOMAIN=6
OWNER_PRIVATE_KEY=
VALIDATOR_PRIVATE_KEY=

# Live server-signer writes are off by default. Enable only for an allowlisted Arc Testnet operator.
ENABLE_LIVE_EXECUTION=false
LIVE_EXECUTION_OPERATOR_ALLOWLIST=
LIVE_EXECUTION_ALLOWED_ORIGINS=http://localhost:3000
LIVE_EXECUTION_MAX_AMOUNT_USDC=200
LIVE_EXECUTION_RATE_LIMIT_PER_MINUTE=3
LIVE_EXECUTION_SIGNATURE_TTL_SECONDS=60
# Production live writes fail closed unless Upstash Redis is configured for cross-instance replay protection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LIVE_EXECUTION_REDIS_NAMESPACE=arc-usdc-rebalancer
# Local development only. Never enable this fallback in production.
LIVE_EXECUTION_ALLOW_IN_MEMORY_GUARD=false
